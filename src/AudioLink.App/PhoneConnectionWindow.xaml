<Window x:Class="AudioLink.PhoneConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接手机 · 同频 AudioLink" Width="510" Height="420" MinWidth="460" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#17221A" Foreground="{StaticResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" Loaded="Window_Loaded">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="连接安卓手机" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,20"/>
      <TextBlock Text="电脑地址" Foreground="{StaticResource Secondary}" Margin="0,0,0,8" ToolTip="手机开启 USB 网络共享后，在接收端填写电脑地址和连接码。"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="AddressBox" Height="43" AutomationProperties.Name="手机连接用的电脑地址"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <Button Grid.Column="1" Content="刷新" Margin="10,0,0,0" Click="Refresh_Click"/>
      </Grid>
      <TextBlock Text="连接码" Foreground="{StaticResource Secondary}" Margin="0,21,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="CodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="31" Foreground="{StaticResource Accent}" Padding="12,7" AutomationProperties.Name="手机连接码"/>
        <Button x:Name="RenewButton" Grid.Column="1" Content="换一个" Margin="10,0,0,0" Click="Renew_Click"/>
      </Grid>
      <TextBlock x:Name="StatusText" Foreground="{StaticResource Secondary}" Margin="0,13,0,0" TextWrapping="Wrap" LineHeight="20"/>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="1" Margin="0,20,0,0"><Button Content="安卓安装包" HorizontalAlignment="Left" Click="Apk_Click"/><Button Content="完成" HorizontalAlignment="Right" Padding="24,10" Click="Close_Click"/></Grid>
  </Grid>
</Window>
